# Required only for AI commands. Keep real keys in .env.
SUBQ_API_KEY=
SUBQ_MODEL=subq-preview
START_URL=https://example.com
# macOS browser-level pointer/focus observation (requires Swift compiler).
REBROWSE_DESKTOP_CONTEXT=true
# Explicit copy/cut/paste text and foreground-browser clipboard context.
REBROWSE_CLIPBOARD_CONTEXT=true
